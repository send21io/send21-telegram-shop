# Leave everything empty to run the full loop locally: mock Telegram (📱 /phone)
# and mock send21 (a local pay simulator). No keys needed.

# --- Telegram (from @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Your own chat id (send /whoami to the bot): 💰 order alerts and /orders.
ADMIN_CHAT_ID=
# Optional webhook mode instead of long polling (https, public):
# TELEGRAM_WEBHOOK_URL=https://shop.example.com
# TELEGRAM_WEBHOOK_SECRET=a-long-random-string-of-32-or-more-chars

# --- send21 (https://send21.io/api-keys, scope drafts:write (+ webhooks:manage to register)) ---
SEND21_API_KEY=
# Printed once by `npm run webhook:register`.
SEND21_WEBHOOK_SECRET=
# Where the shop server is reachable from the internet (send21 posts webhooks here).
PUBLIC_URL=http://localhost:3000

# --- Where you get paid: YOUR own addresses (coin ids in src/currencies.ts) ---
PAY_LIGHTNING=
PAY_OPTIONS=usdc-sol:<your Solana address>,usdt-eth:<your Ethereum address>

# --- Shop ---
# PRODUCTS_FILE=./products.json
SHOP_EXPIRY_HOURS=2
SHOP_SHORTFALL_PERCENT=1
SHOP_MAX_OPEN_ORDERS=3
PORT=3000
DATA_FILE=./data/shop.json
# TRUST_PROXY=1
